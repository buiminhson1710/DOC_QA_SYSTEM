# ===== API keys (chỉ cần key của nhà cung cấp bạn dùng) =====
OPENAI_API_KEY=sk-xxxxxxxx
GEMINI_API_KEY=xxxxxxxx

# ===== Model Local (Ollama) cho chốt chặn bảo mật =====
LOCAL_MODEL_URL=http://localhost:11434
LOCAL_MODEL_NAME=qwen2.5:3b
# Ngưỡng tin cậy để chặn theo kết luận của model local (0-1)
SECURITY_THRESHOLD=0.6
# true: nếu Ollama không phản hồi -> từ chối (503); false: chỉ dùng bộ lọc heuristic
SECURITY_FAIL_CLOSED=false
# Khi model local không chạy: chặn nếu điểm nghi ngờ của bộ lọc heuristic >= ngưỡng này (chặn ngay khi >= 3)
SECURITY_OFFLINE_BLOCK_SCORE=2

# ===== Qdrant =====
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
# (tuỳ chọn) chạy Qdrant embedded không cần server: QDRANT_PATH=./storage/qdrant
QDRANT_PATH=
QDRANT_COLLECTION=legal_docs

# ===== Embedding / Generation (qua litellm) =====
# OpenAI: text-embedding-3-small (dim 1536) | Gemini: gemini/text-embedding-004 (dim 768)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# OpenAI: gpt-4o-mini | Gemini: gemini/gemini-1.5-flash (hoặc model Gemini mới hơn)
GENERATION_MODEL=gpt-4o-mini
# Model dự phòng (cách nhau bằng dấu phẩy) khi model chính 503/hết quota. Để trống nếu không dùng.
GENERATION_FALLBACK_MODELS=
# Model nhẹ/rẻ cho tác vụ đơn giản (chỉnh sửa câu trả lời /api/chat/patch). Để trống = dùng GENERATION_MODEL.
LIGHT_MODEL=
# Giới hạn độ dài ngữ cảnh gửi AI (ký tự) và độ dài câu trả lời (token) để tiết kiệm token.
MAX_CONTEXT_CHARS=8000
ANSWER_MAX_TOKENS=900
# Trả lời trực tiếp (0 token) cho câu tra cứu: Điều N, văn bản sửa đổi/bãi bỏ, danh sách văn bản.
DIRECT_ANSWERS=true
# Cache câu trả lời AI: hỏi lại cùng câu thì không tốn token (giây). Tự vô hiệu khi nạp/xoá tài liệu.
ANSWER_CACHE_TTL_SECONDS=86400

# ===== OCR cho PDF scan =====
# auto: dùng Tesseract nếu đã cài (miễn phí, không giới hạn), nếu không thì dùng AI | tesseract | llm
OCR_ENGINE=auto
OCR_LANG=vie
# Windows: ví dụ C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# OCR bằng AI: số trang gộp trong MỘT lượt gọi (giảm số request/ngày), số lô chạy song song, DPI ảnh
OCR_PAGES_PER_REQUEST=5
OCR_WORKERS=3
OCR_DPI=200
# Model OCR riêng (cần hỗ trợ ảnh). Để trống = dùng GENERATION_MODEL.
OCR_MODEL=
# false: nếu còn trang chưa OCR được thì KHÔNG nạp (tránh văn bản thiếu trang); kết quả đã OCR được lưu để tiếp tục
OCR_ALLOW_PARTIAL=false

# ===== Ứng dụng =====
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=50
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K=6
AMEND_TOP_K=4
# Cổng phạm vi: nếu điểm tương đồng cao nhất < ngưỡng thì KHÔNG gọi model sinh (câu hỏi ngoài tài liệu / tấn công).
# 0 = tắt. Xem top_score trong log CHAT_OK để chọn ngưỡng phù hợp với model embedding của bạn.
MIN_RELEVANCE_SCORE=0
CACHE_TTL_SECONDS=1800
CACHE_MAX_ITEMS=500

# ===== Truy xuất lai (vector + BM25 + RRF) =====
HYBRID_SEARCH=true
LEXICAL_TOP_K=6

# ===== Embedding: batch, timeout, retry (backoff + jitter), cache để tiếp tục khi ingest dở =====
EMBED_BATCH_SIZE=64
EMBED_TIMEOUT=60
# Chỉ retry lỗi tạm thời (429 ngắn hạn, 503, mạng). Hết quota THEO NGÀY / sai khoá / đầu vào lỗi: không retry.
EMBED_MAX_RETRIES=4
EMBED_CACHE=true

# ===== Chẩn đoán OCR =====
# Trang OCR (Tesseract) có độ tin cậy trung bình dưới ngưỡng này bị đánh dấu "low_conf" trong chẩn đoán
OCR_MIN_CONFIDENCE=65

# ===== Công tắc tính năng (để đo/so sánh baseline hoặc rollback từng phần) =====
PIN_ARTICLES=true            # ghim nguyên văn điều khoản + phần sửa đổi vào ngữ cảnh AI
EXPAND_AMENDMENTS=true       # kéo thêm chunk của văn bản sửa đổi/thay thế/bãi bỏ
TRACE_LOG_TEXT=true          # false: trace chỉ ghi độ dài+hash của câu hỏi/câu trả lời (dữ liệu nhạy cảm)
# Thư mục chứa storage/ và logs/ (mặc định: thư mục dự án). Dùng khi chạy test hoặc triển khai dữ liệu riêng.
DATA_DIR=
