{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chạy server (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["src.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "jinja": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Đánh giá RAG (trong tiến trình)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/eval_rag.py",
      "args": ["inprocess", "--out", "eval"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
